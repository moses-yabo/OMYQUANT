MONGODB_URI=mongodb://127.0.0.1:27017/omyquant?replicaSet=rs0
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
# To try persistent local sample bookings instead, omit MONGODB_URI and enable:
# DEMO_MODE=true
# Local JWT auth uses .local/auth.sqlite automatically without MongoDB.
# Optional: JWT_SECRET (at least 32 bytes); otherwise a signing key persists in SQLite.
# For a production-mode server tested over plain localhost HTTP only:
# LOCAL_AUTH=true
# AUTH_COOKIE_SECURE=false
