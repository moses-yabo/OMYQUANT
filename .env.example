# MONGODB_URI=mongodb://127.0.0.1:27017/omyquant?replicaSet=rs0
# Optional Atlas template with raw, quoted database credentials:
# MONGODB_URI=mongodb+srv://<db_username>:<db_password>@your-cluster.mongodb.net/?retryWrites=true&w=majority
# MONGODB_DB_USERNAME="your-database-user"
# MONGODB_PASSWORD="your-raw-database-password"
# MONGODB_DB_NAME=omyquant
APP_ORIGIN=http://localhost:5173
NODE_ENV=development
DEMO_MODE=true
# Accounts, sessions and sample bookings use browser localStorage in demo mode.
# Google sign-in requires MongoDB and a Web application OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback
