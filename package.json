{
  "name": "omyquant",
  "private": true,
  "type": "module",
  "scripts": {
    "admin:grant": "node scripts/admin.ts",
    "admin:revoke": "node scripts/admin.ts --revoke",
    "images:migrate-samples": "node scripts/migrate-sample-images.ts",
    "seed": "node scripts/seed.ts",
    "seed:preview": "node scripts/seed.ts --dry-run",
    "build": "react-router build && tsc -p tsconfig.server.json",
    "dev": "react-router dev",
    "start": "node --env-file-if-exists=.env build/runtime/server.js",
    "typecheck": "react-router typegen && tsc && tsc -p tsconfig.server.json --noEmit",
    "test": "npm run build && npm run test:jest",
    "test:jest": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "npm run test:jest -- --watchAll",
    "test:coverage": "npm run build && npm run test:jest -- --coverage"
  },
  "dependencies": {
    "@react-router/node": "^8.4.0",
    "@react-router/serve": "^8.4.0",
    "@remix-run/node-fetch-server": "^0.14.2",
    "isbot": "^5.1.36",
    "jose": "^6.2.12",
    "mongoose": "^9.11.2",
    "oauth4webapi": "^3.8.8",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.4.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@react-router/dev": "^8.4.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^22",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "jest": "^30.5.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.3"
  }
}
